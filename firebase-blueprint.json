{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email"]
    },
    "FinancialData": {
      "title": "FinancialData",
      "description": "User active financial project cards, accounts, and exchange rates",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "version": { "type": "string", "maxLength": 32 },
        "lastUpdated": { "type": "string", "maxLength": 64 },
        "projectName": { "type": "string", "maxLength": 128 },
        "baseCurrency": { "type": "string", "maxLength": 10 },
        "exchangeRates": { "type": "object" },
        "cards": { "type": "array" },
        "checkingAccounts": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "cards", "checkingAccounts"]
    },
    "VersionSnapshot": {
      "title": "VersionSnapshot",
      "description": "Saved snapshot version of financial project data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "cardsCount": { "type": "number" },
        "totalDebt": { "type": "number" },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "data"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/financialData/{docId}": {
      "schema": "FinancialData",
      "description": "User active financial cards and accounts project"
    },
    "/users/{userId}/snapshots/{snapshotId}": {
      "schema": "VersionSnapshot",
      "description": "User saved financial snapshots"
    }
  }
}
